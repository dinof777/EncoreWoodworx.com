# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# markdown — private by default, so agent-guidance files (CLAUDE.md, AGENTS.md)
# never ship in this public repo. Project documentation is opted back in below.
*.md
!README.md
!DESIGN.md
!SITE.md
!.design/**/*.md

# editor + os cruft
.idea/
.vscode/
*.swp
*~
*.bak
.DS_Store

# scratch + caches
/tmp/
*.log

# any local secrets backups
*.secret
*-secret.*

# photo drop folder — originals stay local; public/photos/ holds the generated output
/photos/*
!/photos/README.md
